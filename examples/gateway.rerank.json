{
  "admission": {
    "rerank": {
      "max_inflight": 1,
      "max_queue": 64,
      "queue_timeout_seconds": 30
    }
  },
  "rerank": {
    "default_strategy": "top_n",
    "execution": {
      "max_documents_per_request": 256,
      "default_batch_size": 4,
      "max_batch_size": 8,
      "max_batch_tokens": 8192,
      "default_max_length": 512,
      "max_length": 8192
    },
    "strategies": {
      "strict": {
        "method": "top_n_and_threshold",
        "parameters": {
          "score_threshold": 0.5,
          "top_n": 5
        },
        "allow_request_parameters": [
          "top_n"
        ],
        "version": "1"
      },
      "russian_documents": {
        "method": "metadata_filter",
        "parameters": {
          "filters": {
            "language": "ru"
          },
          "top_n": 10
        },
        "allow_request_parameters": [
          "top_n"
        ],
        "version": "1"
      }
    },
    "database": {
      "enabled": false,
      "driver": "sqlite",
      "path": "rerank-strategies.db",
      "table": "rerank_strategies",
      "refresh_seconds": 30,
      "required": false
    }
  }
}
