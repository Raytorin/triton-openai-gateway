{
  "admission": {
    "chat": {
      "max_inflight": 4,
      "max_queue": 16,
      "queue_timeout_seconds": 60
    },
    "media": {
      "max_inflight": 2,
      "max_queue": 8,
      "queue_timeout_seconds": 60
    }
  },
  "context_compression": {
    "mode": "summarize",
