# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0
# Opt-in independent runtime track. The official/legacy Dockerfile is unchanged.
ARG TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.10-vllm-python-py3@sha256:06803bff18e43379a7ecb4ce46feed537ca717c06c5472b354aec94bf20466e2
ARG RUNTIME_IMAGE=triton-openai-gateway:deepseek-local
ARG OS_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

FROM ${TRITON_IMAGE} AS native
COPY docker/unified/assemble-native.py /tmp/assemble-native.py
RUN python3 /tmp/assemble-native.py --output /unified-root

# A materialized, manifested artifact from Dockerfile.triton-gateway-deepseek.
# Only its independent environment/toolkit are copied into the final image.
FROM ${RUNTIME_IMAGE} AS inference

FROM ${OS_IMAGE} AS unified
ARG GATEWAY_VERSION=0.7.0
ARG TRITON_IMAGE
ARG RUNTIME_IMAGE
ARG OS_IMAGE
LABEL org.opencontainers.image.title="Triton OpenAI Gateway" \
      org.opencontainers.image.version="${GATEWAY_VERSION}" \
      org.opencontainers.image.source="https://github.com/Raytorin/triton-openai-gateway" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.github.raytorin.runtime-track="unified-vllm032"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl util-linux procps g++ \
       libb64-0d libarchive13t64 libnuma1 libxml2 libcurl4t64 libssl3t64 libexpat1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=native /unified-root/ /
COPY --from=inference /opt/envs/vllm032-cu129 /opt/envs/vllm032-cu129
COPY --from=inference /opt/cuda/12.9 /opt/cuda/12.9
COPY --from=inference /opt/runtime-artifacts/vllm032-cu129 /opt/runtime-artifacts/vllm032-cu129
COPY --from=inference /opt/runtime-manifests/vllm032-cu129.json /opt/runtime-manifests/vllm032-cu129.base.json

ENV PATH=/opt/envs/vllm032-cu129/bin:/opt/cuda/12.9/bin:/opt/tritonserver/bin:/opt/ffmpeg-safe/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH=/opt/envs/vllm032-cu129/lib:/opt/tritonserver/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64 \
    VIRTUAL_ENV=/opt/envs/vllm032-cu129 \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    NVIDIA_REQUIRE_CUDA="cuda>=9.0" \
    CUDA_VERSION=13.4.3.001 CUDA_DRIVER_VERSION=615.71.09 \
    CUDA_ARCH_LIST="7.5 8.0 8.6 9.0 10.0 12.0" MAXSMVER="" \
    NVIDIA_PRODUCT_NAME="Triton Server" NVIDIA_TRITON_SERVER_VERSION=26.10 \
    TRITON_SERVER_VERSION=2.74.0 TRITON_SERVER_GPU_ENABLED=1

COPY backends/vllm_deepseek /opt/tritonserver/backends/vllm_deepseek
COPY backends/vllm_multimodal /opt/tritonserver/backends/vllm_multimodal
COPY backends/vllm_multimodal/utils/thinking_budget.py /opt/tritonserver/backends/vllm/utils/thinking_budget.py
COPY docker/unified /opt/tritonserver/unified
COPY docker/patch-native-thinking-budget.py /tmp/patch-native-thinking-budget.py
COPY docker/deepseek-runtime-manifest.py docker/verify-deepseek-runtime.py /opt/tritonserver/tools/deepseek/
COPY docker/runtime-locks/vllm032-cu129.requirements.txt docker/runtime-locks/vllm032-cu129.inputs.json docker/runtime-locks/unified-vllm032.requirements.txt docker/runtime-locks/unified-vllm032.inputs.json /opt/tritonserver/runtime-locks/
# Preserve NVIDIA's codec/licensing-constrained FFmpeg build for local ASR.
# Ubuntu supplies only its shared OS dependencies, not a replacement FFmpeg.
COPY --from=native /opt/ffmpeg-safe /opt/ffmpeg-safe
RUN apt-get update \
    && apt-get install -y --no-install-recommends libdav1d7 libopus0 libsoxr0 libvorbisenc2 libvpx9 libxcb1 \
    && rm -rf /var/lib/apt/lists/* \
    && printf '%s\n' /opt/ffmpeg-safe/lib > /etc/ld.so.conf.d/ffmpeg-safe.conf \
    && ldconfig \
    && /opt/ffmpeg-safe/bin/ffmpeg -version >/dev/null
# Verify the donor before applying the explicitly recorded gateway overlay.
RUN python3 /opt/tritonserver/tools/deepseek/deepseek-runtime-manifest.py verify \
       --manifest /opt/runtime-manifests/vllm032-cu129.base.json \
    && python3 -I /opt/tritonserver/unified/launch.py --exec /opt/envs/vllm032-cu129/bin/python3.12 -m pip download \
       --no-cache-dir --no-deps --require-hashes --only-binary=:all: --dest /tmp/unified-wheelhouse \
       --index-url https://pypi.org/simple -r /opt/tritonserver/runtime-locks/unified-vllm032.requirements.txt
RUN python3 -I /opt/tritonserver/unified/launch.py --exec /opt/envs/vllm032-cu129/bin/python3.12 -m pip install \
       --no-cache-dir --no-index --find-links /tmp/unified-wheelhouse --only-binary=:all: --require-hashes \
       -r /opt/tritonserver/runtime-locks/unified-vllm032.requirements.txt \
    && rm -rf /tmp/unified-wheelhouse \
    && python3 /opt/tritonserver/unified/install.py --triton-root /opt/tritonserver \
    && printf '%s\n' /opt/tritonserver/lib /usr/local/cuda-13.4/targets/x86_64-linux/lib > /etc/ld.so.conf.d/triton-core.conf \
    && ldconfig \
    && python3 /tmp/patch-native-thinking-budget.py \
    && rm /tmp/patch-native-thinking-budget.py \
    && python3 -I /opt/tritonserver/unified/launch.py --exec /opt/envs/vllm032-cu129/bin/python3.12 \
       /opt/tritonserver/unified/verify-environment.py --imports

COPY gateway /opt/tritonserver/gateway
COPY gateway/model_config.py gateway/model_cleanup.py /usr/local/libexec/triton-openai-gateway/
COPY watch_triton.sh /usr/local/bin/watch_triton.sh
COPY docker/triton-gateway /usr/local/bin/triton-gateway
COPY docker/80-watch-triton.sh docker/90-triton-chat-gateway.sh /opt/nvidia/entrypoint.d/
COPY scripts/validate_deepseek_checkpoint.py scripts/validate_deepseek_tokenizer.py docker/smoke-deepseek-stub.py /opt/tritonserver/tools/deepseek/
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /opt/tritonserver/licenses/triton-openai-gateway/
RUN chmod 0755 /usr/local/bin/watch_triton.sh /usr/local/bin/triton-gateway \
       /opt/nvidia/entrypoint.d/80-watch-triton.sh /opt/nvidia/entrypoint.d/90-triton-chat-gateway.sh \
       /opt/tritonserver/unified/entrypoint.sh \
    && python3 /opt/tritonserver/unified/compose-inputs.py \
       --base-manifest /opt/runtime-manifests/vllm032-cu129.base.json \
       --base-lock /opt/tritonserver/runtime-locks/vllm032-cu129.requirements.txt \
       --base-inputs /opt/tritonserver/runtime-locks/vllm032-cu129.inputs.json \
       --overlay-lock /opt/tritonserver/runtime-locks/unified-vllm032.requirements.txt \
       --overlay-inputs /opt/tritonserver/runtime-locks/unified-vllm032.inputs.json \
       --triton-image "${TRITON_IMAGE}" --runtime-image "${RUNTIME_IMAGE}" --os-image "${OS_IMAGE}" \
       --output /opt/tritonserver/unified/inputs.json
RUN python3 /opt/tritonserver/tools/deepseek/deepseek-runtime-manifest.py create \
       --inputs /opt/tritonserver/unified/inputs.json --manifest /opt/runtime-manifests/unified-vllm032.json \
    && python3 -I /opt/tritonserver/unified/launch.py --exec /opt/envs/vllm032-cu129/bin/python3.12 \
       -c 'import sys; sys.path.insert(0,"/opt/tritonserver"); import gateway.app; print("Unified gateway import passed")' \
    && (/opt/tritonserver/bin/tritonserver --help >/tmp/triton-help.log 2>&1 || test "$?" -eq 1) \
    && grep -q -- '--model-repository' /tmp/triton-help.log \
    && rm -rf /tmp/triton-runtime-cache /root/.cache/pip /tmp/triton-help.log

WORKDIR /opt/tritonserver
EXPOSE 8000 8001 8002 8080
ENTRYPOINT ["/opt/tritonserver/unified/entrypoint.sh"]
CMD ["tritonserver"]
